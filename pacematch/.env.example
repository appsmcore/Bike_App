# Shared keys for Flutter + Vite route-playground (copy to .env and fill in)
#
# Flutter: GH_API_KEY / ORS_API_KEY (VITE_* also accepted)
# Vite:    VITE_GH_API_KEY / VITE_ORS_API_KEY (envDir = this folder)
#
# Supabase (real login for web testing — https://supabase.com)
# Project Settings → API → Project URL + anon public key

GH_API_KEY=
ORS_API_KEY=

VITE_GH_API_KEY=
VITE_ORS_API_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
